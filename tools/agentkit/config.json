{
 "build_cmd": "make -j$(nproc) strix-halo",
 "bench_binary": "ds4-bench",
 "warmup_args": [
  "--ctx-frontiers",
  "2048",
  "--ctx-alloc",
  "4096",
  "--gen-tokens",
  "0"
 ],
 "metrics": [
  "prefill_tps",
  "gen_steady_tps",
  "gen_tps"
 ],
 "sclk_glob": "/sys/class/drm/card*/device/pp_dpm_sclk",
 "temp_glob": "/sys/class/drm/card*/device/hwmon/hwmon*/temp1_input",
 "busy_url": "http://127.0.0.1:8000/v1/models",
 "ledger_path": "ledger/claims.jsonl"
}
