# Default supervisor profile: the Strix Halo V4.1 setup (Cockpit container on :8000).
# Sourced by bash. Scalars can be overridden per launch with --set KEY=VALUE;
# --env / --backend-env append to PAYLOAD_ENV / BACKEND_ENV. See supervisor.d/README.md.

PI_BIN=/home/dani/.local/share/pi-node/node-v22.23.2-linux-x64/bin/pi
PI_RESUME_ARGS=(--tui-mode regular)

MODEL=/home/dani/models/deepseek-v4.1/DeepSeek-V4.1-Flash-1017-IQ2_XXS-Q2_K-imatrix.gguf
MIN_FREE_GIB=100
MEMORY_WAIT_S=240
PAYLOAD_TIMEOUT=3600

# Environment for every payload (in addition to --env). Inherited DS4_* are cleared first.
PAYLOAD_ENV=(
  DS4_BENCH_SNAPSHOT_MAX_BYTES=2147483648
  LD_LIBRARY_PATH=/opt/rocm/lib:${LD_LIBRARY_PATH:-}
)

BACKEND=podman
HEALTH_URL=http://127.0.0.1:8000/v1/models
HEALTH_WAIT=900
BACKEND_PORT=8000

# The running container is detected by port and recreated from its own captured
# create command. The settings below are only the fallback when it was not running.
CONTAINER_NAME_FALLBACK=ds4-cockpit-server
CONTAINER_RECREATE=replay
CONTAINER_IMAGE=localhost/ds4-v41-optimized:latest
CONTAINER_RUN_ARGS=(
  --device /dev/dri --device /dev/kfd --group-add keep-groups
  --security-opt seccomp=unconfined --ipc=host --cap-add=SYS_PTRACE
  --security-opt label=disable --userns=keep-id
  -p 127.0.0.1:8000:8000
  -v /home/dani/models/deepseek-v4.1:/models:ro
)
BACKEND_ENV=(
  DS4_LOCK_FILE=/tmp/ds4-cockpit-server.lock
  DS4_ROCM_V41_SELECTIVE_STAGE=1
)
SERVER_ARGS=(
  -m /models/DeepSeek-V4.1-Flash-1017-IQ2_XXS-Q2_K-imatrix.gguf
  --ctx 131072 --host 0.0.0.0 --port 8000
  --ssd-streaming --ssd-streaming-cache-experts 92GB
)
